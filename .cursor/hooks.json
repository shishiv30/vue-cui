{
	"version": 1,
	"hooks": {
		"beforeShellExecution": [
			{
				"command": ".claude/hooks/run-tests-before-push.sh cursor",
				"matcher": "^git\\s+push(\\s|$)",
				"failClosed": true,
				"timeout": 1800
			}
		],
		"postToolUse": [
			{
				"command": "node .claude/hooks/post-bash.mjs cursor",
				"matcher": "Shell",
				"timeout": 5
			}
		]
	}
}
