{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"allowJs": true,
		"noEmit": true,
		"types": ["vite/client", "google.maps"]
	},
	"include": [
		"client/src/**/*.ts",
		"client/src/**/*.vue",
		"server/**/*.ts",
		"vite.config.ts"
	]
}
