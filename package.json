{
	"name": "@shishiv30/vue-cui",
	"version": "0.1.0",
	"description": "Performance-first Vue 3 UI component library",
	"main": "./dist-lib/index.js",
	"type": "module",
	"scripts": {
		"dev:client": "vite --port 3001",
		"dev:server": "npx cross-env NODE_ENV=development tsx server/index.ts",
		"dev": "npx cross-env NODE_ENV=development concurrently \"vite --port 3001\" \"tsx server/index.ts\"",
		"build:dev": "npx cross-env NODE_ENV=development npm run build:vite && npx cross-env NODE_ENV=development tsx server/index.ts",
		"build:vite": "vite build && vite build --ssr client/src/entry-server.ts --outDir dist/server --emptyOutDir false",
		"build:prod": "npx cross-env NODE_ENV=production npm run build:vite",
		"build:stage": "npx cross-env NODE_ENV=stage npm run build:vite",
		"build-docker:dev": "npx cross-env NODE_ENV=development ./run-docker.sh",
		"build-docker:prod": "npx cross-env NODE_ENV=production ./run-docker.sh",
		"docker:run": "./run-container.sh",
		"start": "npx cross-env NODE_ENV=production tsx server/index.ts",
		"test": "npx tsx --test test/*.test.js && node test/test-geo-mapping.js && node test/test-auto-detection.js && node test/test-dialog-plugin.js",
		"lint": "eslint helpers/geo.js helpers/routes/ client/js/core/router.js client/js/index.js helpers/property.js helpers/article.js",
		"storybook": "npx cross-env LAUNCH_EDITOR=./scripts/open-cursor.sh storybook dev -p 6006",
		"build:storybook": "storybook build -o dist/storybook",
		"test:storybook": "vitest --project=storybook",
		"test-storybook": "vitest --project=storybook",
		"postinstall": "node scripts/fix-storybook-coverage-reporter.mjs",
		"clean": "rm -rf dist",
		"prebuild": "npm run clean",
		"build:lib": "vite build -c vite.lib.config.ts && node scripts/build-lib-css.mjs",
		"prepack": "npm run build:lib"
	},
	"license": "MIT",
	"engines": {
		"node": ">=25.6.0"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.5.1",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/vue3-vite": "^10.6.2",
		"@types/compression": "^1.7.5",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"concurrently": "^9.2.0",
		"cross-env": "^7.0.3",
		"eslint": "^8.57.1",
		"playwright": "^1.64.1",
		"sass": "^1.57.0",
		"storybook": "^10.6.2",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vite": "^7.0.0",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.0.5",
		"vue": "^3.5.0",
		"vue-tsc": "^3.3.13"
	},
	"dependencies": {
		"@vue/server-renderer": "^3.5.0",
		"compression": "^1.7.4",
		"cors": "^2.8.5",
		"dotenv": "^16.5.0",
		"ejs": "^3.1.10",
		"express": "^4.21.2",
		"express-session": "^1.18.0",
		"express-useragent": "^1.0.15",
		"fuse.js": "^7.0.0",
		"geoip-lite": "^1.4.10",
		"mime": "^4.0.7",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"vue-router": "^4.5.0",
		"vuex": "^4.1.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shishiv30/vue-cui.git"
	},
	"homepage": "https://shishiv30.github.io/vue-cui/",
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist-lib"
	],
	"module": "./dist-lib/index.js",
	"types": "./dist-lib/lib/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-lib/lib/index.d.ts",
			"import": "./dist-lib/index.js"
		},
		"./style.css": "./dist-lib/style.css"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
